# --- FRONTEND REACT ---
FRONTEND_PORT=3001

# --- CLOUDFLARE TUNNEL & N8N ---
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_cloudflare_aqui
N8N_PORT=5678
N8N_PUBLIC_URL=http://localhost:5678

# --- SERVICIO EWS EMAIL (Exchange) ---
EWS_USERNAME=DOMINIO\usuario.resultados
EWS_PASSWORD=
EWS_API_KEY=
EWS_URL=https://correo.dominio.gob.mx/EWS/Exchange.asmx
EWS_EMAIL=usuario.resultados@dominio.gob.mx

# --- CONFIGURACIÓN DEL MCP DE N8N (Antigravity local) ---
# El MCP se configura en: C:\Users\<usuario>\.gemini\config\mcp_config.json
