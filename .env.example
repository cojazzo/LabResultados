# --- BASE DE DATOS POSTGRESQL ---
POSTGRES_USER=lab_user
POSTGRES_PASSWORD=cambiar_esta_contrasena_segura_2026
POSTGRES_DB=lab_resultados
DB_PORT=5433

# --- BACKEND FASTAPI ---
SECRET_KEY=cambiar_esta_llave_secreta_de_produccion
BACKEND_PORT=8001
BACKEND_BASE_URL=http://localhost:8000
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Contraseña del usuario admin (solo se usa al crear la BD por primera vez)
